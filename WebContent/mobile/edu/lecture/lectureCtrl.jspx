<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">

	<jsp:directive.page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" />
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="jdf.framework.view.auth.User" />
	<jsp:directive.include file="/common/common.jsp"/>
	
	
	<jsp:declaration>
	<![CDATA[   

/******************************************************************************** 
 * Program ID		: 강좌
 * FileName		    : lectureCtrl.jspx
 * @author		    : 최성수
 * @version		    : 1.0
 * Comment		    : 
 ********************************************************************************/           
	         
	private static final String JSP_BASE="/mobile/edu/lecture/";
	
	private static final String JSP_LECTURE = "_lecture";
	
	private static final String JSP_LECTURE_LIST=JSP_BASE+JSP_LECTURE+"_list.jsp";
	
	private static final String JSP_LECTURE_VIEW=JSP_BASE+JSP_LECTURE+"_view.jsp";
		
	protected String getDefaultMethodName()
	{
		return "viewLectureList"; 
	}
	
	
	public void viewLectureList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		
		try
		{	
			input.put("cmd", "GET_LECTURE_CODE_LIST");
			DataSet output = interact.execute( "/edu/LectureMgr" , input);
			
			String new_start = "";
			String new_end = "";
			String old_start = "";
			String old_end = "";
			String new_req = "N";
			String old_req = "N";
			String new_std_yyyy = "";
			String old_std_yyyy = "";
			String new_lecture_seq_no = "";
			String old_lecture_seq_no = "";
			if( output.getCount("lecture_seq_no") == 2)
			{
				int int_cur_day = Integer.parseInt(DateTime.getFormatString("yyyyMMdd")); 
				for(int idx =0; idx <output.getCount("lecture_seq_no") ; idx++)
				{						
					String lecture_seq_no = output.getText("lecture_seq_no",idx);
					String lecture_div = output.getText("lecture_div",idx);
					if( "1".equals(lecture_div) )
					{
						new_std_yyyy = output.getText("std_yyyy",idx);
						new_lecture_seq_no = lecture_seq_no;
						new_start = DateTime.trans( output.getText("start_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						new_end = DateTime.trans(  output.getText("end_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						
						int int_new_start = Integer.parseInt(output.getText("start_dd",idx));
						int int_new_end = Integer.parseInt(output.getText("end_dd",idx));
						
						if( int_new_start <= int_cur_day &&  int_new_end >= int_cur_day)
							new_req = "Y";
						
						String new_teminate_yn = output.getText("teminate_yn",idx);
						if("Y".equals(new_teminate_yn)) new_req = "N";
					}else{
						old_std_yyyy = output.getText("std_yyyy",idx);
						old_lecture_seq_no = lecture_seq_no;
						old_start = DateTime.trans( output.getText("start_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						old_end = DateTime.trans( output.getText("end_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						int int_old_start = Integer.parseInt(output.getText("start_dd",idx));
						int int_old_end = Integer.parseInt(output.getText("end_dd",idx));
						
						if( int_old_start <= int_cur_day &&  int_old_end >= int_cur_day)
							old_req = "Y";
						
						String old_teminate_yn = output.getText("teminate_yn",idx);
						if("Y".equals(old_teminate_yn)) old_req = "N";
					}
				}
			}
			req.setAttribute("new_std_yyyy", new_std_yyyy);
			req.setAttribute("old_std_yyyy", old_std_yyyy);
			req.setAttribute("new_lecture_seq_no", new_lecture_seq_no);
			req.setAttribute("old_lecture_seq_no", old_lecture_seq_no);
			req.setAttribute("new_start", new_start);
			req.setAttribute("new_end", new_end);
			req.setAttribute("old_start", old_start);
			req.setAttribute("old_end", old_end);
			req.setAttribute("new_req", new_req);
			req.setAttribute("old_req", old_req);
			
			req.setAttribute("input", input);
			view.setViewPage(JSP_LECTURE_LIST);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));	
		}
	}
	
	public void viewLectureView(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		
		try
		{	
			input.put("cmd", "GET_LECTURE_DETAIL");
			DataSet lectureView = interact.execute( "/edu/LectureMgr" , input);
			
			User session_user = getUserObject(req, resp);
			DataSet s_userData = session_user.getDataSet();
			input.put("s_emp_no", session_user.getId());
			input.put("s_emp_name", session_user.getName());						
			input.put("s_email", session_user.getEmail());
			input.put("s_tel_no", session_user.getHpNo());
			input.put("s_user_seq_no", session_user.getUser_seq_no());
			input.put("s_user_ip", session_user.getIp());
			
			req.setAttribute("input", input);
			req.setAttribute("detail", lectureView);
			view.setViewPage(JSP_LECTURE_VIEW);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));	
		}
	}
	
	]]>
	</jsp:declaration>

</jsp:root>   