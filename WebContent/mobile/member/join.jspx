	private static final String JSP_BASE="/mobile/member/";
	
	private static final String JSP_PREFIX = "_mem";
	
	private static final String JSP_JOIN_STEP_1=JSP_BASE+JSP_PREFIX+"_join_step_1.jsp";
	
	private static final String JSP_JOIN_STEP_2=JSP_BASE+JSP_PREFIX+"_join_step_2.jsp";
	
	private static final String JSP_JOIN_STEP_3=JSP_BASE+JSP_PREFIX+"_join_step_3.jsp";
	
	private static final String JSP_JOIN_STEP_4=JSP_BASE+JSP_PREFIX+"_join_step_4.jsp";
	
	private static final String JSP_JOIN_STEP_5=JSP_BASE+JSP_PREFIX+"_join_step_5.jsp";
	
	private static final String JSP_JOIN_STEP_6=JSP_BASE+JSP_PREFIX+"_join_step_6.jsp";
	
	private static final String JSP_JOIN_STEP_7=JSP_BASE+JSP_PREFIX+"_join_step_7.jsp";
	
	
	protected String getDefaultMethodName()
	{
		return "join_step_1";
	}
	
	public void join_step_1(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		try
		{	
			input.put("cmd", "GET_LECTURE_CODE_LIST");
			DataSet output = interact.execute( "/edu/LectureMgr" , input);
			
			String new_start = "";
			String new_end = "";
			String old_start = "";
			String old_end = "";
			
			if( output.getCount("lecture_seq_no") == 2)
			{
				int int_cur_day = Integer.parseInt(DateTime.getFormatString("yyyyMMdd")); 
				for(int idx =0; idx <output.getCount("lecture_seq_no") ; idx++)
				{						
					String lecture_seq_no = output.getText("lecture_seq_no",idx);
					String lecture_div = output.getText("lecture_div",idx);
					if( "1".equals(lecture_div) )
					{
						new_start = DateTime.trans( output.getText("start_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						new_end = DateTime.trans(  output.getText("end_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");						
					}else{
						old_start = DateTime.trans( output.getText("start_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");
						old_end = DateTime.trans( output.getText("end_dd",idx) , "yyyyMMdd", "yyyy년 MM월 dd일");						
					}
				}
			}
			req.setAttribute("new_start", new_start);
			req.setAttribute("new_end", new_end);
			req.setAttribute("old_start", old_start);
			req.setAttribute("old_end", old_end);
			
			req.setAttribute("input", input);
			view.setViewPage(JSP_JOIN_STEP_1);
		} catch(Exception ex)
		{	
			throw ex;
		}
	}

	public void join_step_2(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
		try
		{	
			req.setAttribute("input", input);
			
			if(MEM_DIV_NEW.equals(input.getText("mem_div")) )
			{
				view.setViewPage(JSP_JOIN_STEP_2);
			}else if(MEM_DIV_REP.equals(input.getText("mem_div")) ){
				view.setViewPage(JSP_JOIN_STEP_2);
			}else{
				view.setViewPage(JSP_JOIN_STEP_1);
			}
		} catch(Exception ex)
		{	
			throw ex;
		}
	}
	
