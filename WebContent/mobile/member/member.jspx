	private static final String JSP_BASE="/mobile/member/";
	
	private static final String JSP_PREFIX = "_mem";
	
	private static final String JSP_ID_FIND=JSP_BASE+JSP_PREFIX+"_find_id.jsp";
	
	private static final String JSP_PASSWD_FIND=JSP_BASE+JSP_PREFIX+"_find_passwd.jsp";
	
	private static final String JSP_PASSWD_FIND_CONFIRM=JSP_BASE+JSP_PREFIX+"_find_passwd_confirm.jsp";
	
	private static final String JSP_MODIFY=JSP_BASE+JSP_PREFIX+"_modify.jsp";	
	
	private static final String JSP_PASS=JSP_BASE+JSP_PREFIX+"_password.jsp";
	
	public void id_find(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
		try
		{	
			
			req.setAttribute("input", input);
			view.setViewPage(JSP_ID_FIND);
		} catch(Exception ex)
		{	
			throw ex;
		}
	}
	
	public void passwd_confirm(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
		try
		{	
			req.setAttribute("input", input);
			view.setViewPage(JSP_PASSWD_FIND_CONFIRM);
		} catch(Exception ex)
		{	
			throw ex;
		}
	}

	public void passwd_find(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
