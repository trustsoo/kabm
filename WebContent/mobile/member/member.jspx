	public void memModifyView(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
		DataSet reqOutput = new DataSet();
		try
		{	
			jdf.framework.view.auth.User session_user = getUserObject(req , resp);
			String user_id = "";
			if(session_user != null )user_id = session_user.getId();
			
			input.put("user_id", user_id);
			input.put("cmd", "MEM_INFO");			
			output = interact.execute( "/member/MemberMgr" , input);
			
			input.put("user_seq_no", session_user.getUser_seq_no());
			input.put("cmd", "GET_MEMBER_REQ");			
			reqOutput = interact.execute( "/member/MemberMgr" , input);
			
			req.setAttribute("input", input);
			req.setAttribute("output", output);
			req.setAttribute("reqOutput", reqOutput);
			
			view.setViewPage(JSP_MODIFY);
			
		} catch(Exception ex)
		{	
			throw ex;
		}
	}
	
	public void passModifyView(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);		
		
		DataSet output = new DataSet();
		try
		{	
			jdf.framework.view.auth.User session_user = getUserObject(req , resp);
			String user_id = "";
			if(session_user != null )user_id = session_user.getId();
			
			req.setAttribute("input", input);
			
			view.setViewPage(JSP_PASS);
		} catch(Exception ex)
		{	
			throw ex;
		}
	}
	]]>
	</jsp:declaration>

</jsp:root>   