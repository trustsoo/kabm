function lf_requestSubmit(div)
{
	var mem_div = jQuery('#mem_div').val();
	
	if( div == '0')
	{
		if(mem_div == '<%=MEM_DIV_NEW%>')
		{
			if( jQuery("input:checkbox[id='chk_0']").is(":checked") == false )
			{
				msgStart(msg_join_code_01);
				return;
			}

		}
		
		if( jQuery("input:checkbox[id='chk_1']").is(":checked") == false )
		{
			msgStart(msg_join_code_02);
			return;
		}
		
		if( jQuery("input:checkbox[id='chk_2']").is(":checked") == false )
		{
			msgStart(msg_join_code_03);
			return;
		}
		
		var url = '/mobile/member/join.jspx?cmd=join_step_3';
		jQuery('#frm').attr('action', url);
		jQuery('#frm').submit();
		
	}else{
		location.href='/mobile/member/join.jspx?cmd=join_step_1';
	}
	
}



</script>
