	public void certSms(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			bind(req, input);	
			
			req.setAttribute("templet-bypass", "true");
			try
			{			
				
				String certNo =  com.kabm.util.PasswordUtil.getPassword();
				
				String subject = "[한국건물위생관리협회]본인확인";
				String sms_msg = "인증번호는 다음과 같습니다. [" +certNo + "]";
				
				sendSMS( subject, sms_msg,  "본인확인" , input.getText("sms_tel_no")  );
					
				String data = "{\"resultCode\":\""+certNo+"\"}";
				data = getJsonFormat(data);
				responseJson(data, resp);
				
			} catch(Exception ex)
			{	
				responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
			}
		}

		public void certEmail(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			bind(req, input);	
			
			req.setAttribute("templet-bypass", "true");
			try
			{			
				
				String certNo =  com.kabm.util.PasswordUtil.getPassword();
					
					Hashtable<String, String> mailArgs = new Hashtable<String, String>();
					
					String mail_title = "[한국건물위생관리협회]본인확인 메일입니다.";
					String content = "인증번호 : [" + certNo + "]";
					String title = "휴대전화 본인확인 인증번호";
					mailArgs.put("title", title);
					mailArgs.put("content", content);
					
					DataSet receiver = new DataSet();
					receiver.put("email", input.getText("cert_email"), 0);
					receiver.put("name","본인확인", 0);
					receiver.put("user_id",certNo , 0);
					com.kabm.util.SendMailUtil mail = new com.kabm.util.SendMailUtil();
					mail.setting("default_mail.html", mail_title, mailArgs, receiver);
					mail.sendMail();
					
				String data = "{\"resultCode\":\""+certNo+"\"}";
				data = getJsonFormat(data);
				responseJson(data, resp);
				
			} catch(Exception ex)
			{	
				responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
			}
		}
