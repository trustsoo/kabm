	public void idFinderSms(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		
		req.setAttribute("templet-bypass", "true");
		try
		{			
			
			input.put("cmd", "ID_CHECK_SMS");			
			DataSet output = interact.execute( "/member/MemberMgr" , input);
			String resultCode = "100";
			if(output.size() > 0)
			{
				String user_ids = "";
				for(int idx =0;idx< output.getCount("user_id");idx++)
				{
					if(idx == 0)
						user_ids =  "["+output.getText("user_id",idx)+ "]";
					else
						user_ids =  user_ids + "," + "["+output.getText("user_id",idx)+ "]";
				}
				String subject = "[한국건물위생관리협회]아이디확인";
				String sms_msg = "회원님 아이디는 다음과 같습니다. " + user_ids;
				
				sendSMS( subject, sms_msg,  input.getText("user_nm") , input.getText("tel_no")  );
				
				resultCode = "200";
				
			}else{
				resultCode = "300";
			}
			String data = "{\"resultCode\":\""+resultCode+"\"}";
			data = getJsonFormat(data);
			responseJson(data, resp);
			
		} catch(Exception ex)
		{	
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}

	public void idFinderEmail(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		
		req.setAttribute("templet-bypass", "true");
		try
		{			
			
			input.put("cmd", "ID_CHECK_EMAIL");			
			DataSet output = interact.execute( "/member/MemberMgr" , input);
			String resultCode = "100";
			if(output.size() > 0)
			{	
				Hashtable<String, String> mailArgs = new Hashtable<String, String>();
				
				String mail_title = "[한국건물위생관리협회]아이디확인 메일입니다.";
				String content = "아이디 : [" + output.getText("user_id") + "]";
				String title = input.getText("user_nm") + "회원님  아이디는 다음과 같습니다.";
				mailArgs.put("title", title);
				mailArgs.put("content", content);
				
				DataSet receiver = new DataSet();
				receiver.put("email", input.getText("email"), 0);
				receiver.put("name",input.getText("user_nm") , 0);
				receiver.put("user_id",output.getText("user_id") , 0);
				com.kabm.util.SendMailUtil mail = new com.kabm.util.SendMailUtil();
				mail.setting("default_mail.html", mail_title, mailArgs, receiver);
				mail.sendMail();
				
				resultCode = "200";
				
			}else{
				resultCode = "300";
			}
			String data = "{\"resultCode\":\""+resultCode+"\"}";
			data = getJsonFormat(data);
			responseJson(data, resp);
			
		} catch(Exception ex)
		{	
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void passFinderSms(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		
		req.setAttribute("templet-bypass", "true");
		try
		{			
			
			input.put("cmd", "PASS_CHECK_SMS");			
			DataSet output = interact.execute( "/member/MemberMgr" , input);
			String resultCode = "100";
			if(output.size() > 0)
			{
				String encKey = com.kabm.util.SitePropertyManager.getString("ENCRYPTION_KEY");
				input.put("ENCRYPTION_KEY", encKey);
				
				String password = com.kabm.util.PasswordUtil.getPassword();
				input.put("password", password);
				input.put("cmd", "MODIFY_TMP_PASSWORD");
				interact.execute( "/member/MemberMgr" , input);
				
				String subject = "[한국건물위생관리협회]비밀번호확인";
				String sms_msg = "회원님 임시비밀번호는 다음과 같습니다. [" + password + "]";
				
				sendSMS( subject, sms_msg, input.getText("user_nm") , input.getText("tel_no") );
		
				resultCode = "200";
				
			}else{
				resultCode = "300";
			}
			String data = "{\"resultCode\":\""+resultCode+"\"}";
			data = getJsonFormat(data);
			responseJson(data, resp);
			
		} catch(Exception ex)
		{	
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}

