	public void doPasswordModify(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();					
		bind(req, input);
		
		req.setAttribute("templet-bypass", "true");
		try
		{
			
			jdf.framework.view.auth.User session_user = getUserObject(req , resp);
			String user_id = "";
			if(session_user != null )user_id = session_user.getId();
			
			String encKey = SitePropertyManager.getString("ENCRYPTION_KEY");
			input.put("ENCRYPTION_KEY", encKey);
			
			input.put("user_id", user_id);
			input.put("cmd", "MODIFY_PASSWORD");
			DataSet output = interact.execute( "/member/MemberMgr" , input);
			
			String data = "{\"user_id\":\""+output.getText("user_id")+"\"}";
			data = getJsonFormat(data);
			responseJson(data, resp);
			
		} catch(Exception ex)
		{	
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
