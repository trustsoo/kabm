	    private final String UTIL_CONTACT_US = "/util/_contact_us.jsp";   //광고문의  

	    

	    
	    protected String getDefaultMethodName()
		{
			return "index"; 
		}
		public void index(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	    			throws ServletException, IOException, Exception
		{
		}

	    public void agreement1(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	    			throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			DataSet output = new DataSet();
			
			bind(req, input);
			try
			{	
				view.setViewPage(UTIL_AGREEMENT01);
				
			} catch(Exception ex)
			{
				throw ex;
			}
		}
	    

	    public void agreement2(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
