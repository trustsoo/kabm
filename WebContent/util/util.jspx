	<jsp:directive.page import="com.kabm.util.*" />	
	<jsp:directive.include file="/common/common.jsp"/>
	<jsp:declaration>
	<![CDATA[
	         
	    private final String UTIL_AGREEMENT01 = "/util/_agreement_1.jsp";   //이용약관
	    private final String UTIL_AGREEMENT02 = "/util/_agreement_2.jsp";   //개인정보처리방침
	    private final String UTIL_AGREEMENT03 = "/util/_agreement_3.jsp";   //저작권보호 
	    
