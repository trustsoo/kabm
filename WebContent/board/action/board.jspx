	<![CDATA[
	
	public void delJob(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{		
		DataSet input = new DataSet();
		DataSet output = new DataSet();		
		bind(req, input);	
		
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmd", "deleteJob");		
			interact.execute("/community/board", input);
			
			String result = getJsonFormat("");
			responseJson(result, resp);
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			 Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	         
	public void getJobList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		DataSet readAuth = new DataSet();
		bind(req, input);
	
		
		try
		{
			req.setAttribute("templet-bypass", "true");			
			
			input.put("cmd", "job_list");		
			output = interact.execute("/community/board", input);
			String[] blockNames = new String[] {"property", "job_list" };
			 
			 output.put(jdf.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("board_row_per_page"));
			 output.put(jdf.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
			 
			 output.put(jdf.framework.logic.transform.TransFormConstant.JSON_DATA_TYPE, "");
			 
			 String result = getJson(output, blockNames);
			 responseJson(result, resp);	
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			 Logger.err.print(Utility.getStackTrace(ex));
		 }
	}         
	         
	         
	public void createJobWrite(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		 throws ServletException, IOException, Exception 
	 {
		 DataSet input = new DataSet();
		 DataSet output = new DataSet();
		 DataSet authput = new DataSet();
		 
		 boolean isAddOK = true;
		 
		 bind(req, input);
			
			
		 req.setAttribute("templet-bypass", "true");
		 try {
			 
			 if("".equals(input.getText("brd_no")))
			 {
				 input.put("brd_no", "-1");
			 }
			 
			 
			 if("".equals(input.getText("p_brd_no")))
			 {
				 input.put("p_brd_no", "-1"); 
			 }
			 
				 
			 //첨부파일.
			 String file_nm = input.getText("file_nms");
			 String file_path = input.getText("file_paths");
			 String file_size = input.getText("file_sizes");
			 String ext_nm = input.getText("ext_nms");
			 String user_file_nm = input.getText("user_file_nms");
			 
			
			 String[] file_nms = SmartStringArray.split(",", file_nm);
			 String[] file_paths = SmartStringArray.split(",", file_path);
			 String[] file_sizes = SmartStringArray.split(",", file_size);
			 String[] ext_nms = SmartStringArray.split(",", ext_nm);
			 String[] user_file_nms = SmartStringArray.split(",", user_file_nm);
			
			 input.put("rg_empl_no", getUserObject(req, resp).getId());
			 input.put("file_nms", file_nms);
			 input.put("file_nms", file_nms);
			 input.put("file_paths", file_paths);
			 input.put("file_sizes", file_sizes);
			 input.put("ext_nms", ext_nms);
			 input.put("user_file_nms", user_file_nms);
			 
			 input.put("cmd", "createJobBoard");
			 output = interact.execute("/community/board", input);
			 
			 String brd_mng_no = input.getText("brd_mng_no");
			 
			 String result = getJsonFormat("");
			 responseJson(result, resp);
			
		 } catch (Exception ex) {
			 responseJson(
					 getJsonFormat(
							 HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,
							 ex.getMessage(), ""), resp);
			 Logger.err.print(Utility.getStackTrace(ex));
		 }
	 }         
	         
	         
	         
	public void createQuestion(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		try
		{	
			input.put("cmd", "insert_answer");
			interact.execute("/mng/content/question_action", input, output);
			String result = getJsonFormat("");
			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			throw ex;				
		}
	}
	         
	         
