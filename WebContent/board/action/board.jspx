    public void doBoardRead(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		try
		{
			
			String emp_no = "";
			
			try
			{
				if(getUserObject(req, resp) != null && getUserObject(req, resp).getId() != null)
				{			
					emp_no = getUserObject(req, resp).getId();
				}	
			} catch(Exception ex)
			{}
			
			
			input.put("emp_no", emp_no);
			
			input.put("cmd", "doBoardRead");
			interact.execute("/community/board", input, output);
			
			String[] blockNames = new String[] { "board_detail"};

			String result = getJson(output, blockNames);
			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			ex.printStackTrace();
			throw ex;				
		}
	}
    
    
  //댓글 등록.
  	 public void doCommentAdd(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		 throws ServletException, IOException, Exception 
	 {
		 DataSet input = new DataSet();
		 DataSet output = new DataSet();
		 bind(req, input);
		
			
		 req.setAttribute("templet-bypass", "true");
		 input.put("use_emp_no", getUserObject(req, resp).getId() );
		 
		 try {			
			 input.put("cmd", "doCommentAdd");
			 output = interact.execute("/community/board", input);
			 
			 String result = getXMLFormat("");
			 responseXML(result, resp);
		 } catch (Exception ex) {
			 responseXML(
					 getXMLFormat(
							 HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,
							 ex.getMessage(), ""), resp);
			 Logger.err.print(Utility.getStackTrace(ex));
		 }
	 }
 
  	 //댓글 삭제.
  	 public void doCommentDel(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
  			 throws ServletException, IOException, Exception 
  	 {
  		 DataSet input = new DataSet();
  		 DataSet output = new DataSet();
  		 bind(req, input);
  		
  	
  		boolean isAdmin = isContainUserGroup(req, resp, "BOARDMNG");
  			
  		 req.setAttribute("templet-bypass", "true");
  		 
  		 if(isAdmin )
  			 input.put("use_emp_no", input.getText("use_emp_no") );
  		 else
  			 input.put("use_emp_no", getUserObject(req, resp).getId() );
  		 
  		 try {			
  			 input.put("cmd", "doCommentDel");
  			 output = interact.execute("/community/board", input);

  			 String result = getXMLFormat("");
  			 responseXML(result, resp);
  		 } catch (Exception ex) {
  			 responseXML(
  					 getXMLFormat(
  							 HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,
  							 ex.getMessage(), ""), resp);
  			 Logger.err.print(Utility.getStackTrace(ex));
  		 }
  	 }
  	 
  	//댓글 조회.
	 public void doCommentRead(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			 throws ServletException, IOException, Exception 
	 {
		 DataSet input = new DataSet();
		 DataSet output = new DataSet();
		 bind(req, input);
			
			
		 req.setAttribute("templet-bypass", "true");
		 //input.put("rg_empl_no", getUserObject(req, resp).getId() );
		 
		 try {			
			 input.put("cmd", "doCommentRead");
			 output = interact.execute("/community/board", input);
			 String[] blockNames = new String[] { "comment_info" };
			 
			 String result = getXML(output, blockNames);		
			 responseXML(result, resp);
		 } catch (Exception ex) {
			 responseXML(
					 getXMLFormat(
							 HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,
							 ex.getMessage(), ""), resp);
			 Logger.err.print(Utility.getStackTrace(ex));
		 }
	 }
  
    
