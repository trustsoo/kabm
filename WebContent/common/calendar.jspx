	<jsp:declaration>
	<![CDATA[
	         
	private final String LIST = "/common/_calendar.jsp";	
	private final String CALENDAR_LIST = "/common/_calendar_list.jsp";

	public void calendar(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();			
		bind(req, input);
		try
		{	
			req.setAttribute("glbl_schdl_type", "01");
			req.setAttribute("input", input);
			view.setViewPage(LIST);				
		} catch(Exception ex)
		{
			throw ex;
		}
	}
    
    public void calendar_list(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();			
		bind(req, input);
		try
		{	
			req.setAttribute("glbl_schdl_type", "01");
			req.setAttribute("input", input);
			view.setViewPage(CALENDAR_LIST);				
		} catch(Exception ex)
		{
			throw ex;
		}
	}
    
    public void edu_calendar(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
