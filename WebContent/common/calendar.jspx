		try
		{	
			req.setAttribute("glbl_schdl_type", "02");
			req.setAttribute("input", input);
			view.setViewPage(CALENDAR_LIST);				
		} catch(Exception ex)
		{
			throw ex;
		}
	}
	         
	         
	]]>
	</jsp:declaration>
</jsp:root>