	public String unfilter(String input) {
        if(input==null) {
            return null;
        }
        
        String clean = input.replaceAll("&quot;", "\"").replaceAll("&#039;","\'").replaceAll("&#043;", "\\+");
        clean = clean.replaceAll("&lt;", "<").replaceAll("&gt;", ">");
        clean = clean.replaceAll("&#40;", "\\(").replaceAll("&#41;", "\\)");
        return clean;
    }
	]]>
	</jsp:declaration>
</jsp:root>
	