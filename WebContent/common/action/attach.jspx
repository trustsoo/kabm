	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[
	
	
	
	public void getAttachList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmd", "get_attach_files_by_datano");			
			output = interact.execute("/common/Attach", input);
			String[] blockNames = new String[]{"file_entries"};						
			
			String result = getJson(output, blockNames);
			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void getActAttachList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmd", "get_act_attach_files_by_datano");			
			output = interact.execute("/common/Attach", input);
			String[] blockNames = new String[]{"file_entries"};						
			
			String result = getJson(output, blockNames);
			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void doDownload(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "get_attach_file");			
			output = interact.execute("/common/Attach", input);
			
			if(!"".equals(output.getText("file_nm")))
			{
				Config conf = Configuration.lookup("/MultipartAttributes");
				String rootDir = conf.getString("dir");
				
				
				File file = new File(rootDir+java.io.File.separator+output.getText("file_path")+java.io.File.separator+output.getText("file_nm"));
				
				Logger.debug.println(output);
				Logger.debug.println(file.getAbsolutePath());
				
				if(file.exists())
					sendFileStream(output.getText("user_file_nm"), (int)file.length(), file, resp, req);
				else
					resp.sendError(resp.SC_NOT_FOUND);
			}
			
		} catch(Exception ex)
		{
			Logger.err.print(Utility.getStackTrace(ex));
			resp.sendError(resp.SC_NOT_FOUND);			
		}
	}
	
	public void doDelete(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "get_attach_file");			
			output = interact.execute("/common/Attach", input);
			
			if(!"".equals(output.getText("file_nm")))
			{				
				File file = new File(output.getText("file_path")+java.io.File.separator+output.getText("file_nm"));		
				//log(file.getAbsolutePath() +" is exist ? "+ file.exists());
				file.delete();
			}
			input.put("file_nos", input.getText("file_no"));
			input.put("cmd", "drop");			
			interact.execute("/common/Attach", input);
			responseXML(getXMLFormat(""), resp);
			
		} catch(Exception ex)
		{
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void doDownloadForMail(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "get_attach_file");			
			output = interact.execute("/common/Attach", input);
			
			if(!"".equals(output.getText("file_nm")))
			{
				Config conf = Configuration.lookup("/MultipartAttributes");
				String rootDir = conf.getString("dir");
				String subdir = SitePropertyManager.getString("EMAIL_SUB_DIR"); 
				
				File file = new File(rootDir+java.io.File.separator+subdir+java.io.File.separator+output.getText("file_path")+java.io.File.separator+output.getText("file_nm"));
				
				Logger.debug.println(output);
				Logger.debug.println(file.getAbsolutePath());
				
				if(file.exists())
					sendFileStream(output.getText("user_file_nm"), (int)file.length(), file, resp, req);
				else
					resp.sendError(resp.SC_NOT_FOUND);
			}
			
		} catch(Exception ex)
		{
			Logger.err.print(Utility.getStackTrace(ex));
			resp.sendError(resp.SC_NOT_FOUND);			
		}
	}
	
