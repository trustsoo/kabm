<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8"
		pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="java.security.*" />	
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	
	<jsp:directive.include file="/common/common.jsp"/>
r	<jsp:declaration>
	<![CDATA[

	   	public void updatePw(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
				throws ServletException, IOException, Exception {
			
			DataSet input = new DataSet();
			DataSet output = new DataSet();
			bind(req, input);

			try {
				HttpSession session = req.getSession(); 
				String secu_old_psswd = input.getText("secu_old_psswd");
				String secu_new_psswd = input.getText("secu_new_psswd");
				String secu_new_psswd_chk = input.getText("secu_new_psswd_confirm");
				PrivateKey privateKey = (PrivateKey) session.getAttribute("__rsaPrivateKey__");			
									
		        if (privateKey == null) {
		            throw new RuntimeException("암호화 비밀키 정보를 찾을 수 없습니다.");
		        }
		        
	        	String old_psswd = decryptRsa(privateKey, secu_old_psswd);
	        	String new_psswd = decryptRsa(privateKey, secu_new_psswd);
	        	String new_psswd_chk = decryptRsa(privateKey, secu_new_psswd_chk);
	            input.put("old_psswd", old_psswd);
	            input.put("new_psswd", new_psswd);
	            input.put("new_psswd_chk", new_psswd_chk);					
				
     			String cmpny_no =  "1";					
				String encKey = SitePropertyManager.getString("ENCRYPTION_KEY");
			   	input.put("ENCRYPTION_KEY", encKey);
			   	
			   	if(input.getText("user_id").equals(""))  input.put("user_id", getUserObject(req, resp).getId());
			   	
				input.put("cmd", "getOldPwCheck");
				
				output = interact.execute("/user/PassWD", input);
									
				String[] blockNames = new String[] { "check_info" };
				String jsonData = getJson(output, blockNames);
				//Logger.info.println("jsonData:"+jsonData);
									
				responseJson(jsonData, resp);

			} catch (Exception ex) {
				responseXML(
						getXMLFormat(
								HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,
								ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
			}
		}
	     	
	     public void changeUserPw(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	     		throws ServletException, IOException, Exception
	     {		
	     	DataSet input = new DataSet();
	     	DataSet output = new DataSet();
	     	bind(req, input);
	     	
	     	req.setAttribute("templet-bypass", "true");
	     	try
	     	{
				String cmpny_no =  getUserObject(req, resp).getCmpnyNo();
		   		
				input.put("emp_no", getUserObject(req, resp).getUser_seq_no());
				
				if( !input.getText("new_pw").equals(input.getText("new_pw_chk")) )
				{
					responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, "\"새비밀번호\"와 \"새비밀번호확인\"이 다릅니다.", ""), resp);
					//responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR,"\"새비밀번호\"와 \"새비밀번호확인\"이 다릅니다.", ""), resp);
				} else
				{
					String encKey =  SitePropertyManager.getString("ENCRYPTION_KEY");
					input.put("cmd", "password_change");
					input.put("ENCRYPTION_KEY", encKey);
					input.put("psswd", input.getText("new_pw"));					
					output = interact.execute("/user/Login", input);					
					
					int updateCnt = Integer.parseInt(output.getProperty("rowcount.update:password_change"));
					
					if(updateCnt > 0)
					{	
						input.put("cmd", "syncWithMsg");
						input.put("psswd", input.getText("new_pw"));
						input.put("user_id", getUserObject(req, resp).getId() );
						interact.execute("/messenger/MsgUser", input);
						responseJson(getJsonFormat(""), resp);
					} else
					{
						responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, "\"현재비밀번호\"가 틀립니다.", ""), resp);
					}
				}
				
	     			
	     	} catch(Exception ex)
	     	{
	     		responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
	     		Logger.err.print(Utility.getStackTrace(ex));
	     	}
	     }
	     
	     private String decryptRsa(PrivateKey privateKey, String securedValue) throws Exception {
		        
				javax.crypto.Cipher cipher = javax.crypto.Cipher.getInstance("RSA");
		        byte[] encryptedBytes = hexToByteArray(securedValue);		        
		        cipher.init(javax.crypto.Cipher.DECRYPT_MODE, privateKey);		        
		        byte[] decryptedBytes = cipher.doFinal(encryptedBytes);
		        String decryptedValue = new String(decryptedBytes, "utf-8"); // 문자 인코딩 주의.
		        return decryptedValue;
		    }
		
		    /**
		     * 16진 문자열을 byte 배열로 변환한다.
		     */
		    public static byte[] hexToByteArray(String hex) {
		        if (hex == null || hex.length() % 2 != 0) {
		            return new byte[]{};
		        }
		
		        byte[] bytes = new byte[hex.length() / 2];
		        for (int i = 0; i < hex.length(); i += 2) {
		            byte value = (byte)Integer.parseInt(hex.substring(i, i + 2), 16);
		            bytes[(int) Math.floor(i / 2)] = value;
		        }
		        return bytes;
		    }
	     
	     	
]]>
	</jsp:declaration>
</jsp:root>
	