			responseJson(result, resp);	
			
		} catch(Exception ex)
		{			
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	//일정 등록.
    public void doEventAdd(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception 
        {
            DataSet input = new DataSet();
            DataSet output = new DataSet();
            bind(req, input);
               
            try {
            	boolean isok = true;
            	String schdl_div = input.getText("schdl_div");
            	String schdl_type = input.getText("schdl_type");
            	String ins_emp_info_yn = "N";
            	
            	if( schdl_div != null && "GLOBAL_SCHEDULE".equals(schdl_div)){
            		if(schdl_type != null && "GLBL_HOLIDAY".equals(schdl_type)){
            			
            		}
            		isok = false;
            	}            	
            	else 
            		isok = false;
            	
            	input.put("emp_no", getUserObject(req, resp).getUser_seq_no());
            	input.put("cmpny_no", getUserObject(req, resp).getCmpnyNo());
            	
            	if( isok)
            		output = interact.execute("/common/Calendar", input);
                
                String result = getXMLFormat(output.getText("seq_no"));
                responseXML(result, resp);
            } catch (Exception ex) {
            	responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
    			Logger.err.print(Utility.getStackTrace(ex));
            }
        }
    
    //일정 삭제.
    public void doEventDel(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception 
    {
        DataSet input = new DataSet();
        DataSet output = new DataSet();
        bind(req, input);
           
        try {          
            
        	String schdl_div = input.getText("schdl_div");
            if( schdl_div != null && "GLOBAL_SCHEDULE".equals(schdl_div))
                input.put("cmd", "doGlobalEventDel");
            
            input.put("emp_no", getUserObject(req, resp).getUser_seq_no());
            input.put("cmpny_no", getUserObject(req, resp).getCmpnyNo());
            
            output = interact.execute("/common/Calendar", input);

            String result = getXMLFormat("");
            responseXML(result, resp);
        } catch (Exception ex) {
        	responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
        }
    }
	]]>
	</jsp:declaration>
</jsp:root>	