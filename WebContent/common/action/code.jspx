	public void getWeekOfMonthList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		try
		{
			req.setAttribute("templet-bypass", "true");
			String _yyyy = input.getText("yyyy");
			String _mm = input.getText("mm");
			
			
			if(_yyyy.equals("")) _yyyy = DateTime.getFormatString("yyyy");
			if(_mm.equals("")) _mm = DateTime.getFormatString("MM");
			
			int yyyy = Integer.parseInt(_yyyy);
			int mm = Integer.parseInt(_mm);			
			int dd = 1;			
			int last_week_num = 0;
			int first_day_week_of_day = 0;
			String last_date_of_month_date = null;
			//log(input.toString());
			
			Calendar cal = Calendar.getInstance();
			cal.clear();
			cal.set(Calendar.YEAR, yyyy);
			cal.set(Calendar.MONTH, mm);
			cal.add(Calendar.MONTH, -1);		
			
			first_day_week_of_day = cal.get(Calendar.DAY_OF_WEEK);
			cal.set(Calendar.DATE, cal.getActualMaximum(Calendar.DATE));    // 마지막 날짜를 넣어서 셋팅해준다.	
			
			last_date_of_month_date = DateTime.getString(cal.getTime(), "yyyyMMdd");
			//log(DateTime.getString(cal.getTime(), "yyyyMMdd"));
			
			last_week_num = cal.get(Calendar.WEEK_OF_MONTH);
			
			List<String> weekList = new ArrayList<String>();
			
			StringBuffer sb = new StringBuffer();
			
			
			String monday_date = null;
			String sunday_date = null;
			int dummy_monday_month = 0;
			cal.set(Calendar.DATE, 1);
			for(int idx=1; idx<=last_week_num; idx++)
			{					
				if(first_day_week_of_day > 2)
				{
					if(idx == 1)
					{
						//cal.add(Calendar.MONTH, 1);
					} else if(idx == 2)
					{
						cal.add(Calendar.MONTH, 1);					
					}
				}
				cal.set(Calendar.WEEK_OF_MONTH, idx);
				cal.set(Calendar.DAY_OF_WEEK, Calendar.MONDAY);				
				monday_date = DateTime.getString(cal.getTime(), "yyyyMMdd");				
				sunday_date = DateTime.getAdjustDate(monday_date, Calendar.DATE, 6);
				
				sb.append("<cd_list>")
				  .append("<cd>")
				  .append(StringFormater.fillZero(idx+"", 2))
				  .append("</cd>")
				  .append("<cd_nm>")
				  .append(idx+"주차 ("+DateTime.trans(monday_date, "yyyyMMdd", "yyyy-MM-dd")+"-"+DateTime.trans(sunday_date, "yyyyMMdd", "yyyy-MM-dd")+")")
				  .append("</cd_nm>")
				  .append("</cd_list>");;
				if(sunday_date.equals(last_date_of_month_date+"")) break;
			}
			
			String data = getXMLFormat(sb.toString());
			responseXML(data, resp);
		} catch(Exception ex)
		{
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
