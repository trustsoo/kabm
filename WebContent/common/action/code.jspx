	public void getCodeListTreeFormat(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		JSONObject jsonObj = new JSONObject();
		try
		{
			req.setAttribute("templet-bypass", "true");
			String cmpny_no = getUserObject(req, resp).getCmpnyNo();
			
			input.put("cmpny_no", cmpny_no);
			input.put("cmd", "getCodeListByPrntCd");
			output = interact.execute("/common/Code", input);
			//log(output.toString());
			JSONArray jsonArray = new JSONArray();
			JSONObject itemObj = null;
			JSONObject itemSubObj = null;
			for(int idx=0; idx<output.getMaxDataSize();idx++)
			{
				itemObj = new JSONObject();
				itemObj.put("id", output.getText("cd", idx));
				itemObj.put("name", output.getText("cd_nm", idx));
				itemObj.put("type", output.getText("type", idx));
				itemObj.put("prnt_cd", input.getText("prnt_cd"));
				itemSubObj = new JSONObject();
				itemSubObj.put("id", output.getText("cd", idx));
				itemSubObj.put("children", output.getText("type", idx) == "folder" ? "true" : "false");
				itemSubObj.put("itemSelected", "false");				
				itemObj.put("additionalParameters", itemSubObj);	
				jsonArray.put(itemObj);				
			}
			
			
			jsonObj.put("status", "OK");
			jsonObj.put("data", jsonArray);
			
			responseJson(jsonObj.toString(), resp);
		} catch(Exception ex)
		{
			Logger.err.print(Utility.getStackTrace(ex));
			jsonObj.put("status", "ERR");
			jsonObj.put("message", ex.toString());
			responseJson(jsonObj.toString(), resp);
		}
	}
	
