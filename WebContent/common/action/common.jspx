	public void sencr(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{		
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		try
		{
			String plainKey = SitePropertyManager.getString("ENCRYPTION_KEY");
            input.put("ENCRYPTION_KEY", plainKey);
            int plainKeyLen = plainKey.length();
            byte[] encryptKeyBytes = new byte[32];
            String data = input.getText("s");
            jdf.framework.core.util.encrypt.KISA_SHA256.SHA256_Encrpyt( plainKey.getBytes(), plainKeyLen, encryptKeyBytes );                    
            data = jdf.framework.core.util.encrypt.CipherUtil.hexToString(jdf.framework.core.util.encrypt.CipherUtil.encode(encryptKeyBytes, data.getBytes("utf-8")));
            responseJson(getJsonFormat("\""+data+"\""), resp);
			
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
