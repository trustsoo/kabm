	public void suggestEmpList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	   		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		try
		{	
			req.setAttribute("templet-bypass", "true");
			
			String result = com.kabm.util.SyllablesLoader.searchJson(com.kabm.filter.JDFContext.MAP_EMPINFO_KEY, getUserObject(req, resp).getCmpnyNo(), input.getText("q"));
			//log(result);
			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void suggestMenuListByMenuNo(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
   		throws ServletException, IOException, Exception
   	{
    	DataSet input = new DataSet();
		DataSet output = new DataSet();
		req.setAttribute("templet-bypass", "true");
		bind(req, input);
		try
		{	
			req.setAttribute("templet-bypass", "true");
			input.put("cmpny_no", getUserObject(req, resp).getCmpnyNo());
			if("".equals(input.getText("q")) || input.getText("q").length() <= 1) return;
			
			String result = null;
			
			jdf.framework.view.menu.bean.MenuMgrBean mgr = jdf.framework.view.menu.bean.MenuMgrBean.getInstance(req, false);
			jdf.framework.view.menu.entity.WebSiteMenu menu = mgr.getWebSiteMenu();
			List<jdf.framework.view.menu.entity.MenuItem> menuList =menu.getMenuListById(input.getText("q"));
			
			/*for(jdf.framework.view.menu.entity.MenuItem item : menuList)
			{
				log(item.toString());
			}*/
			
			
			DataSet userMenu = (DataSet)getUserObject(req, resp).getAttribute("menu_dataset");
			
			
			
			JSONObject jObject = new JSONObject();
			JSONArray jArray = new JSONArray(); 
			
			for(jdf.framework.view.menu.entity.MenuItem item : menuList)
			{
				
				boolean isContainUserMenu = false;
				for(int idx=0; idx<userMenu.getMaxDataSize(); idx++)
				{
					if(item.getId().equals(userMenu.getText("menu_id", idx)))
					{
						isContainUserMenu = true;
						break;
					}
				}
				
				//Logger.debug.println(item.getId());
				
				int userMenuIdx = userMenu.findValueIndex("menu_id", item.getId());
				
				JSONObject atom = new JSONObject();
				atom.put("menu_id", item.getId());
				atom.put("menu_nm", item.getName());
				atom.put("menu_url", item.getUrl());
				atom.put("popup_yn", item.getPopupYN());
				
				/*if(item.getId().equals("10100"))
				{
					Logger.debug.println(">>>>>>>>>>>>>>>>>"+item.isVisiable()+","+userMenuIdx);
				}*/
				
				
				if(!jArray.contains(atom) && item.isVisiable() && isContainUserMenu)				
					jArray.add(atom);
			}
			
			jObject.put("menuList", jArray);
			jObject.put("count", menuList.size());
			
			responseJson(jObject.toString(), resp);
			
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
   	} 
	
	

