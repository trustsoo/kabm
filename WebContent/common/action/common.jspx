	public void getCorpList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		
		try
		{	
			input.put("search_gbn_hcode" , "20");
			input.put("cmd", "GET_CORP_LIST");			
			DataSet output = interact.execute( "/common/CommonMgr" , input);
			
			String[] blockNames = new String[] {"property", "corp_info" };
			
			output.put(jdf.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("row_per_page"));
			output.put(jdf.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
			
			String result = getXML(output, blockNames);
			responseXML(result, resp);	
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));
			String message = ex.getMessage();
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, message, ""), resp);
		}
	}
	
