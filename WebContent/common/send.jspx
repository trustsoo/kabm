<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8"
		pageEncoding="UTF-8" />

	<jsp:directive.page
		extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="java.util.UUID" />
	<jsp:directive.page	import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	<jsp:directive.include file="/common/common.jsp" />

	<jsp:declaration>
	<![CDATA[
	         
	private final String SMS_SEND_PAGE = "/common/_sms_send.jsp";
	private final String EMAIL_SEND_PAGE = "/common/_email_send.jsp";

	//문자 발송 페이지
	public void sms_send(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) 
			throws ServletException, IOException, Exception {
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);

		try 
		{
			req.setAttribute("input", input);
			req.setAttribute("output", output);

			view.setViewPage(SMS_SEND_PAGE);

		} catch (Exception ex) 
		{
			throw ex;
		}
	}

	//이메일 발송 페이지
	public void email_send(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) 
			throws ServletException, IOException, Exception {
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);

		try 
		{
			req.setAttribute("input", input);
			req.setAttribute("output", output);
			view.setViewPage(EMAIL_SEND_PAGE);

		} catch (Exception ex) 
		{
			throw ex;
		}
	}]]></jsp:declaration>
</jsp:root>

