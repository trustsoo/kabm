		public void page_include(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
				throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			DataSet output = new DataSet();
			
			bind(req, input);
			try
			{	
				//req.setAttribute("templet-bypass", "true");
				//req.setAttribute("templet", "no-apply");
				req.setAttribute("input", input);
				req.setAttribute("output", output);
				view.setViewPage(PAGE_INCLUDE_PAGE);
			} catch(Exception ex)
			{
				throw ex;
			}
		}
		
		public void getPasswordChange(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
				throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			DataSet output = new DataSet();
			
			bind(req, input);
			try
			{				
				req.setAttribute("cmpny_no", getUserObject(req, resp).getCmpnyNo());
				req.setAttribute("input", input);
				view.setViewPage(PASSWORD_CHANGE_PAGE);
			} catch(Exception ex)
			{
