			}
		}
		
		public void offlineEduList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
		{
			DataSet input = new DataSet();
			bind(req, input);
			
			try
			{	
				DataSet output = interact.execute("/common/jiinfo_all", input);	

				req.setAttribute("output_count" ,  output.getCount("jicode") - 1);
				req.setAttribute("output" 		,  output.toList());
				
				req.setAttribute("input", input);
				view.setViewPage(JSP_OFFLINE_EDU_LIST);
				
			} catch(Exception ex)
			{	
				Logger.warn.println(Utility.getStackTrace(ex));	
			}
		}
	    
	]]>
	</jsp:declaration>
</jsp:root>