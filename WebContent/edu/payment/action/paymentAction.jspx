	public void downBill(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		DataSet output = new DataSet();
		req.setAttribute("templet-bypass", "true");
		try
		{	
			input.put("cmd", "GET_PAYMENT_INFO");
			executeBL( "/payment/PaymentMgr" , input,output);
			String issue_dt = output.getText("issue_dt");
			String lgd_paydate = output.getText("last_modify_dt");
			if(lgd_paydate != null && !"".equals(lgd_paydate))
				issue_dt = lgd_paydate;
			String[] issue_arr = issue_dt.split("-");
			System.out.println( issue_dt+ ":" +issue_arr.length );
			if( issue_arr.length == 3)
			{
				output.put("yyyy", issue_arr[0]);
				output.put("mm", issue_arr[1]);
				output.put("dd", issue_arr[2]);
			}
			output.put("no", input.getText("user_lecture_seq_no"));
			output.put("user_nm", output.getText("user_nm"));
			output.put("am_ko" , stramt(output.getText("lgd_amount")));
			output.put("am_no", HtmlFormat.formatInt(output.getText("lgd_amount")));
			String saved_file = com.kabm.pdf.PdfManager.excuteProcess(com.kabm.pdf.PdfManager.IST_Cyber_95 , output);
			
			File file = new File(saved_file);
			
			Logger.debug.println(output);
			Logger.debug.println(file.getAbsolutePath());
			
			if(file.exists())
				sendFileStream("한국건물위생관리협회_교육결제_영수증"+issue_dt+".pdf", (int)file.length(), file, resp, req);
			else
				resp.sendError(resp.SC_NOT_FOUND);
			
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	public void downOfflineBill(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		DataSet output = new DataSet();
		req.setAttribute("templet-bypass", "true");
