	public void createBanking(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		req.setAttribute("templet-bypass", "true");
		try
		{			
			input.put("cmd", "INSERT_BANKING");			
			DataSet output = interact.execute( "/payment/BankingMgr" , input);
			
			String result = getXMLFormat("");
			responseXML(result, resp);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));
			String message = ex.getMessage();
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, message, ""), resp);
		}
	}
	
