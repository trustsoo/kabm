 	public void getPaymentList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{	
			input.put("cmd", "GET_PAYMENT_LIST");
			DataSet output = interact.execute( "/payment/PaymentMgr" , input);
			for(int idx = 0 ; idx < output.getCount("lecture_seq_no"); idx++){

				try
				{
					String lgd_tid = output.getText("lgd_tid",idx);
					if(lgd_tid == null || lgd_tid.isEmpty()) continue;
					String lgd_authkey = GetAuthData(LGD_MID, lgd_tid, LGD_MERTKEY);
					output.put("lgd_authkey", lgd_authkey, idx);
				} catch (Exception ex) {
					ex.printStackTrace();
				}
			}
			
			String[] blockNames = new String[] { "property","payment_info" };
			
			String result = getJson(output, blockNames);
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}

