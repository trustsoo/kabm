	private static final String JSP_BASE="/edu/payment/";
	
	private static final String JSP_BILL = "_bill";
	private static final String JSP_PAY = "_pay";
	private static final String JSP_PAYMENT = "_payment";
	
	private static final String JSP_PAYMENT_LIST=JSP_BASE+JSP_PAYMENT+"_list.jsp";
	
	private static final String JSP_OFFLINE_LIST=JSP_BASE+JSP_PAYMENT+"_offline.jsp";
	
	private static final String JSP_BILL_VIEW=JSP_BASE+JSP_BILL+"_view.jsp";
	
	private static final String JSP_BILL_WRITE=JSP_BASE+JSP_BILL+"_write.jsp";
	
	private static final String JSP_PAY_MEM_DELIVERY=JSP_BASE+JSP_PAY+"_delivery.jsp";
	private static final String JSP_PAY_MEM_DELIVERY_MODIFY=JSP_BASE+JSP_PAY+"_delivery_modify.jsp";
	
	private static final String JSP_PAY_REQ_CROSS=JSP_BASE+JSP_PAY+"_req_crossplatform.jsp";
	private static final String JSP_PAY_REQ_CERT=JSP_BASE+JSP_PAY+"_certKey.jsp";
	private static final String JSP_PAY_REQ=JSP_BASE+JSP_PAY+"_req.jsp";
	private static final String JSP_PAY_RES=JSP_BASE+JSP_PAY+"_res.jsp";
	private static final String JSP_PAY_CANCEL=JSP_BASE+JSP_PAY+"_cancel.jsp";
	private static final String JSP_PAY_RESULT=JSP_BASE+JSP_PAY+"_result.jsp";
	private static final String JSP_PAY_CASH_PAY=JSP_BASE+JSP_PAY+"_cash_pay.jsp";
	
	
	public void viewPaymentList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		
		boolean isMobile = isMobile(req);
		if( isMobile ) resp.sendRedirect("/mobile/edu/payment/paymentCtrl.jspx?cmd=viewPaymentList");
		else{
			try
			{	
				User session_user = getUserObject(req, resp);
				DataSet s_userData = session_user.getDataSet();
				input.put("s_user_ip", session_user.getIp());			
				input.put("s_emp_no", session_user.getId());
				input.put("s_emp_name", session_user.getName());						
				input.put("s_email", session_user.getEmail());
				input.put("s_user_seq_no", session_user.getUser_seq_no());
				
				if( "".equals(input.getText("page_no")))
					input.put("page_no" , "1");
				
				
				input.put("user_id", session_user.getId());
				input.put("cmd", "MEM_INFO");			
				DataSet output = interact.execute( "/member/MemberMgr" , input);
				
				req.setAttribute("output", output);
				req.setAttribute("input", input);
				view.setViewPage(JSP_PAYMENT_LIST);
				
			} catch(Exception ex)
			{	
				Logger.warn.println(Utility.getStackTrace(ex));	
			}
		}	
	}
			
	public void viewPaymentOffline(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
