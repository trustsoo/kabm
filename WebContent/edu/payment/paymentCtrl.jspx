	public void viewBill(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		DataSet output = new DataSet();
		
		try
		{	
			input.put("cmd", "GET_PAYMENT_INFO");
			executeBL( "/payment/PaymentMgr" , input,output);
			String issue_dt = output.getText("issue_dt");
			String[] issue_arr = issue_dt.split("-");
			System.out.println( issue_dt+ ":" +issue_arr.length );
			if( issue_arr.length == 3)
			{
				output.put("issue_yyyy", issue_arr[0]);
				output.put("issue_mm", issue_arr[1]);
				output.put("issue_dd", issue_arr[2]);
			}
			output.put("fmtPrice" , stramt(output.getText("lgd_amount")));
			req.setAttribute("input", input);
			req.setAttribute("output", output);
			view.setViewPage(JSP_BILL_VIEW);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));	
		}
	}
	
	public void writeBill(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);
		DataSet output = new DataSet();
		
		try
		{	
			User session_user = getUserObject(req, resp);
			
			input.put("user_seq_no", session_user.getUser_seq_no() );
			input.put("cmd", "GET_BANKING_INFO");
			executeBL( "/payment/BankingMgr" , input,output);
			
			int cnt = output.getCount("user_seq_no");
			String mode = "C";
			if( cnt > 0 ) mode = "U";
			input.put("mode", mode);
			req.setAttribute("input", input);
			req.setAttribute("output", output);
			view.setViewPage(JSP_BILL_WRITE);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));	
		}
	}
	
	public String stramt(String amt)
	{
		String tmpamt ="";
		amt = "000000000000" + amt;
		int j=0;
		for(int i=amt.length();i>0;i--) {
			j++;
			if (!amt.substring(i-1,i).equals("0")) {
			if (j%4==2) tmpamt ="십"+tmpamt;
			if (j%4==3) tmpamt ="백"+tmpamt;
			if (j>1 && (j%4)==0) tmpamt ="천"+tmpamt;
			}
			if (j==5 && Integer.parseInt(amt.substring(amt.length()-8,amt.length()-4))>0) tmpamt ="만"+tmpamt;
			if (j==9 && Integer.parseInt(amt.substring(amt.length()-12,amt.length()-8))>0) tmpamt ="억"+tmpamt;
			if (j==13 && Integer.parseInt(amt.substring(amt.length()-16,amt.length()-12))>0) tmpamt ="조"+tmpamt;
			if (amt.substring(i-1,i).equals("1")) tmpamt ="일"+tmpamt;
			if (amt.substring(i-1,i).equals("2")) tmpamt ="이"+tmpamt;
			if (amt.substring(i-1,i).equals("3")) tmpamt ="삼"+tmpamt;
			if (amt.substring(i-1,i).equals("4")) tmpamt ="사"+tmpamt;
			if (amt.substring(i-1,i).equals("5")) tmpamt ="오"+tmpamt;
			if (amt.substring(i-1,i).equals("6")) tmpamt ="육"+tmpamt;
			if (amt.substring(i-1,i).equals("7")) tmpamt ="칠"+tmpamt;
			if (amt.substring(i-1,i).equals("8")) tmpamt ="팔"+tmpamt;
			if (amt.substring(i-1,i).equals("9")) tmpamt ="구"+tmpamt;
		}
	
		return tmpamt;
	}
	
	]]>
