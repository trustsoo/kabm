	<jsp:directive.include file="/common/common.jsp"/>
	
	
	<jsp:declaration>
	<![CDATA[         

/******************************************************************************** 
 * Program ID		: 수강관리 
 * FileName		    : classAction.jspx
 * @author		    : 최성수
