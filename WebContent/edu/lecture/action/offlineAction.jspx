	public void getOfflineEduList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		req.setAttribute("templet-bypass", "true");
		try
		{			
			
			input.put("is_date", DateTime.getShortDateString() );
			input.put("cmd", "GET_OFFLINE_EDU_LIST");			
			DataSet output = interact.execute( "/edu/OfflineMgr" , input);
			
			String[] blockNames = new String[] { "property","offline_info" };
			String result = getJson(output, blockNames);
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	public void setOfflineEduInfo(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		req.setAttribute("templet-bypass", "true");
		try
		{			
			User session_user = getUserObject(req, resp);
			
			input.put("user_seq_no" , session_user.getUser_seq_no());
			input.put("cmd", "INSERT_OFFLINE_EDU");			
			DataSet output = interact.execute( "/edu/OfflineMgr" , input);
			
			String user_nm = session_user.getName();
			String tel_no = session_user.getHpNo();
			String mem_div_nm = "신규및승계자교육";
			String mem_div = input.getText("dtl_code");
			if( "03".equals(mem_div)) mem_div_nm = "공중위생관리책임자교육";
			
			String subject = "[한국건물위생관리협회]집합교육접수완료";
			String sms_msg = user_nm+ "님 "+mem_div_nm+"신청서 접수가 완료되었습니다.";
			
			sendSMS( subject, sms_msg, user_nm , tel_no );
			
			String result = getJsonFormat("");
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	public void getOfflineEduInfo(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		req.setAttribute("templet-bypass", "true");
		try
		{			
			input.put("cmd", "getOfflineEdu");			
			DataSet output = interact.execute( "/edu/LectureMgr" , input);
			
			String[] blockNames = new String[] { "offline_edu" };
			
			String result = getJson(output, blockNames);
			System.out.println( result );
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	public void certSms(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		
		req.setAttribute("templet-bypass", "true");
		try
		{	
			User session_user = getUserObject(req, resp);
			String sms_tel_no = input.getText("sms_tel_no");
			
			if(sms_tel_no == null || "".equals(sms_tel_no)) return;
			
			String certNo =  com.kabm.util.PasswordUtil.getPassword();
			
			String subject = "[한국건물위생관리협회]집합교육 본인확인";
			String sms_msg = "인증번호는 다음과 같습니다. [" +certNo + "]";
			
			sendSMS( subject, sms_msg,  "집합교육 본인확인" , sms_tel_no  );
				
			String data = "{\"resultCode\":\""+certNo+"\"}";
			data = getJsonFormat(data);
			responseJson(data, resp);
			
		} catch(Exception ex)
		{	
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
