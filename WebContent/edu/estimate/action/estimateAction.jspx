	private static final String JSP_BASE="/estimate/";
	
	protected String getDefaultMethodName()
	{
		return "getEstimateList";
	}
	/** lecture > _class_list : class list search **/
	public void getEstimateList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		bind(req, input);	
		req.setAttribute("templet-bypass", "true");
		try
		{			
			input.put("cmd", "GET_ESTIMATE_LIST");			
			DataSet output = interact.execute( "/edu/EstimateMgr" , input);
			
			String[] blockNames = new String[] { "property","estimate_info" };
			
			String result = getJson(output, blockNames);
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
	
	/** no use **/
	public void getClassList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
	throws ServletException, IOException, Exception
	{
