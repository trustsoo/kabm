	/** no use **/
	public void setEstimateResult(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();					
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			
			input.put("cmd", "SET_ESTIMATE_RESULT");
			DataSet output = interact.execute( "/edu/EstimateMgr" , input);
			
			String result = getXMLFormat("");
			responseXML(result, resp);
			
		} catch(Exception ex)
		{	
			Logger.warn.println(Utility.getStackTrace(ex));
			String message = ex.getMessage();
			responseXML(getXMLFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, message, ""), resp);
		}
	}
	/** lecture > _class_class : class play final result **/
	public void setNewResult(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();					
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{
			
			input.put("cmd", "SET_NEW_RESULT");
			DataSet output = interact.execute( "/edu/EstimateMgr" , input);
			String status = output.getText("status");
			String result = getJsonFormat(HTTPResultConstant.RESULT_OK, status , "");
			
			responseJson(result, resp);	
			
		 } catch (Exception ex) {
			 responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
				Logger.err.print(Utility.getStackTrace(ex));
		 }
	}
