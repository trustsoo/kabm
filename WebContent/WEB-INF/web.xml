<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee" 
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
version="3.0">
	<jsp-config>
		<taglib>
			<taglib-uri>/tld/menu</taglib-uri>
			<taglib-location>/WEB-INF/tld/menu.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/tld/layout</taglib-uri>
			<taglib-location>/WEB-INF/tld/layout.tld</taglib-location>
		</taglib>
		<taglib>
			<taglib-uri>/tld/el-functions</taglib-uri>
			<taglib-location>/WEB-INF/tld/el-functions.tld</taglib-location>
		</taglib>
	</jsp-config>
	
	<display-name>KABM</display-name>
	<description>
	   Welcome!
	</description>
	
  	<session-config>
		<session-timeout>0</session-timeout>
	</session-config>
	
	<filter>
		<filter-name>XSSFilter</filter-name>
		<filter-class>com.kabm.filter.XSSFilter</filter-class>
		
		<init-param>
			<param-name>exclude-dir</param-name>
			<param-value>/bin</param-value>
		</init-param>
	</filter>

	<filter-mapping>
		<filter-name>XSSFilter</filter-name>
		<url-pattern>*.jspx</url-pattern>
	</filter-mapping>
	
	<filter-mapping>
		<filter-name>XSSFilter</filter-name>
		<url-pattern>*.jsp</url-pattern>
	</filter-mapping>
  
  	<filter>
		<filter-name>CORSFilter</filter-name>
		<filter-class>com.kabm.filter.CORSFilter</filter-class>
		
		<init-param>
			<param-name>include-dir</param-name>
			<param-value>/plugin/messenger/action</param-value>
		</init-param>
	</filter>

	<filter-mapping>
		<filter-name>CORSFilter</filter-name>
		<url-pattern>*.jspx</url-pattern>
	</filter-mapping>	
    
  <filter>
    <filter-name>UI control Filter</filter-name>
    <filter-class>com.kabm.filter.JDFFilter</filter-class>
    <init-param>
      <param-name>request-characterEncoding</param-name>
      <param-value>utf-8</param-value>
    </init-param>
    <init-param>
      <param-name>exclude-dir</param-name>
      <param-value><![CDATA[/templet,/test,/action,/bin, /common/action/login.jspx]]></param-value>
    </init-param>
    
    <init-param>	
      <param-name>menudao-class</param-name>
      <param-value>com.kabm.filter.menu.MultiTenantMenuDao</param-value>
    </init-param>    
	<init-param>	
      <param-name>user-class</param-name>
      <param-value>com.kabm.filter.auth.DbmsAuthCheckerUser</param-value>
    </init-param>
    <init-param>
      <param-name>login-page</param-name>
      <param-value><![CDATA[/login.jsp]]></param-value>
    </init-param>    
    <init-param>
		<param-name>error-page</param-name>
		<param-value>/common/message.jsp</param-value>
	</init-param>
	<init-param>
		<param-name>acl-page</param-name>
		<param-value>/common/acl.jsp</param-value>
	</init-param>    
    <init-param>
		<param-name>xml-error-page</param-name>
		<param-value>/common/xmlMessage.jsp</param-value>
	</init-param> 
	<init-param>
		<param-name>userid-session-name</param-name>
		<param-value>admin_id</param-value>
	</init-param> 
	<init-param>
		<param-name>redirect-url-param</param-name>
		<param-value>redirectUrl</param-value>
	</init-param> 
	<init-param>
		<param-name>cust_keys</param-name>
		<param-value>cust_no,mem_no,memno,s_mem_no,mem_id,loginid,memberguid</param-value>
	</init-param>
	
	<init-param>
      <param-name>unlog-url</param-name>
      <param-value></param-value>
    </init-param>
	
  </filter>
   
  
  <filter-mapping>
    <filter-name>UI control Filter</filter-name>
    <url-pattern>*.htm</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>UI control Filter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>UI control Filter</filter-name>
    <url-pattern>*.jspx</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>UI control Filter</filter-name>
    <url-pattern>/bin/*</url-pattern>
  </filter-mapping>
  
  <listener>
    <listener-class>com.kabm.listener.JDFContextListener</listener-class>
  </listener>
  
  <listener>
    <listener-class>jdf.framework.view.auth.SessionListener</listener-class>
  </listener>
  
  <servlet>
    <servlet-name>FileUploader</servlet-name>
    <servlet-class>com.kabm.svl.FileUploaderSvl</servlet-class>
  </servlet>
  	
  <servlet-mapping>
    <servlet-name>FileUploader</servlet-name>
    <url-pattern>/bin/FileUploader</url-pattern>
  </servlet-mapping>  
  
	<servlet>
	    <description/>
	    <display-name>UploadServlet</display-name>
	    <servlet-name>UploadServlet</servlet-name>
	    <servlet-class>com.kabm.svl.UploadServlet</servlet-class>
	</servlet>
	
	<servlet-mapping>
	    <servlet-name>UploadServlet</servlet-name>
	    <url-pattern>/upload</url-pattern>
	</servlet-mapping>
  <welcome-file-list>
  	<welcome-file>index.html</welcome-file>    
    <welcome-file>index.jsp</welcome-file>    
  </welcome-file-list>
  
  <error-page>
      <error-code>500</error-code>
      <location>/common/error.jsp</location>
  </error-page>
  <error-page>
      <error-code>404</error-code>
      <location>/static/com/404.html</location>
  </error-page>
  
  
  <error-page>  
      <exception-type>java.lang.Throwable</exception-type>  
      <location>/common/message.jsp</location>  
  </error-page>
  
</web-app>

