	<db url="jdbc:apache:commons:dbcp:MSSQLPool" 
	 jdbcDriver="jdf.framework.core.pool.jdbc.DBCP2PoolDriver" 
	 dataSourceName="" />
			
	<connectionPool>

		 <!-- (!!!!!!)필독..
			 maxTotal(구 maxActive) : 동시에 사용될수 있는 최대 커넥션 개수
			 maxWait : connection 사용이 많아져서 connection pool이 비었을 때 대기시간 (단위 1/1000초)
			 maxIdle : 사용되지 않고 풀에 저장될 수 있는 최대 커넥션 개수
			 minIdle : 사용되지 않고 풀에 저장될 수 있는 최소 커넥션 개수
			 removeAbandoned : 유효하지 않는 커넥션의 제거 여부
			 removeAbandonedTimeout : 유효하지 않은 커넥션의 삭제시의 타임아웃
			 logAbandoned : 유효하지 않는 커넥션을 생성한 코드 위치 로그생성 여부
			 validationQuery : 커넥션 유효성 체크 쿼리 
			 testOnBorrow : 커넥션 풀에서 커넥션을 얻어올 때 테스트 실행(기본값: true)
			 testOnReturn : 커넥션 풀로 커넥션을 반환할 때 테스트 실행(기본값: false)
			 testWhileIdle : Evictor 스레드가 실행될 때 (timeBetweenEvictionRunMillis > 0) 커넥션 풀 안에 있는 유휴 상태의 커넥션을 대상으로 테스트 실행(기본값: false)
			 numTestsPerEvictionRun : Evictor 스레드 작동 시 한 번에 검사할 커넥션의 갯수
			 minEvictableIdleTimeMillis : Evictor 스레드 작동 시 커넥션의 유휴 시간을 확인해 설정값 이상일 경우 커넥션을 제거한다(기본값: 30분)
			 timeBetweenEvictionRunsMillis : Evictor 스레드가 작동하는 간격. 기본값은 -1이며 Evictor 스레드의 실행이 비활성화돼 있다.
			 accessToUnderlyingConnectionAllowed 
			 whenBlockExhausted : maxActive를 넘어 섰을때 대기 또는 컨넥션 증가(true:대기, false:증가)
			 defaultTransactionIsolation : transaction isolation level. (1:TRANSACTION_READ_UNCOMMITTED, 2:TRANSACTION_READ_COMMITTED, 4:TRANSACTION_REPEATABLE_READ, 8:TRANSACTION_SERIALIZABLE)
			 오라클의 경우 설정하지 않고, MS-SQL의 경우 1로 세팅한다(쿼리에 WITH(NOLOCK)과 같은 효과)
		-->
		
		<MSSQLPool maxTotal="5"   
            maxWait="10000"
            maxIdle="5"
                  minIdle="3"
            removeAbandoned="true"
            removeAbandonedTimeout="30"    
            logAbandoned="true"
            validationQuery="SELECT 1"    
            testOnBorrow="true"
            testOnReturn="true"
            testWhileIdle="true"
            numTestsPerEvictionRun="5"
            minEvictableIdleTimeMillis="3600000"
            timeBetweenEvictionRunsMillis="60000"
            accessToUnderlyingConnectionAllowed="true"
            whenBlockExhausted="true"
            defaultTransactionIsolation="1"
            url="jdbc:sqlserver://218.237.52.98:1433;DatabaseName=eKabm"
            driver="com.microsoft.sqlserver.jdbc.SQLServerDriver"
            user="sa"
            password="Itams0860"/>
      <SMSPool maxTotal="5"   
            maxWait="10000"
            maxIdle="5"
            minIdle="3"
            removeAbandoned="true"
            removeAbandonedTimeout="30"    
            logAbandoned="true"
            validationQuery="SELECT 1"    
            testOnBorrow="true"
            testOnReturn="true"
            testWhileIdle="true"
            numTestsPerEvictionRun="5"
            minEvictableIdleTimeMillis="3600000"
            timeBetweenEvictionRunsMillis="60000"
            accessToUnderlyingConnectionAllowed="true"
            whenBlockExhausted="true"
            defaultTransactionIsolation="1"
            url="jdbc:sqlserver://218.237.52.98:1433;DatabaseName=eKabm"
            driver="com.microsoft.sqlserver.jdbc.SQLServerDriver"
            user="sa"
            password="Itams0860"/>
		
	</connectionPool>
	
	<network>
