        <sql id="getSurveyQstnInfo">
			<query>
			<![CDATA[
				SELECT				     
   					(SELECT QSTN_CNT FROM tb_survey_paper WHERE PAPER_ID=A.PAPER_ID) qstn_cnt,
					paper_id,
					a.qstn_no,
					qstn_answ,
					answ_type,
					answ_cnt,
					multi_yn,
					multi_cnt,
					b.exmp_seq_no,
					b.exmp_sort_no,
					b.exmp_word,
					ISNULL(a.connect_yn, 'N') AS connect_yn,
         			b.connect_qstn_no,
         			(SELECT count(CASE WHEN ANSW_TYPE = 'S' THEN 1 END) from tb_survey_qstn where paper_id = a.paper_id) as s_cnt,
         			(SELECT count(CASE WHEN ANSW_TYPE = 'D' THEN 1 END) from tb_survey_qstn where paper_id = a.paper_id) as d_cnt,
         			a.qstn_ord
				FROM 
				    tb_survey_qstn a 
				    LEFT OUTER JOIN  tb_survey_qstn_exmp b ON a.qstn_no = b.qstn_no 
				WHERE 
				    paper_id = ?
				ORDER BY a.qstn_ord, b.exmp_sort_no
			]]>
			</query>
			<mapping>
				<setProperty>paper_id</setProperty>
				<getProperty>qstn_cnt, paper_id, qstn_no, qstn_answ, answ_type, answ_cnt, multi_yn, multi_cnt, 
							exmp_seq_no, exmp_sort_no, exmp_word, connect_yn,connect_qstn_no, s_cnt,d_cnt,qstn_ord</getProperty>
			</mapping>
		</sql>
		
		<sql id="getSurveyAnswResult">
			<query>
			<![CDATA[
				SELECT
    				a.answ, b.qstn_no, c.exmp_word, c.exmp_seq_no
				FROM 
				    tb_survey_answ a 
				    INNER JOIN tb_survey_qstn b ON a.qstn_no = b.qstn_no
					LEFT OUTER JOIN tb_survey_qstn_exmp c ON a.answ = CAST(c.exmp_seq_no AS CHAR(50))
				WHERE  a.user_lecture_seq_no = ?
			]]>
			</query>
			<mapping>
				<setProperty>user_lecture_seq_no</setProperty>
				<getProperty>answ, qstn_no, exmp_word, exmp_seq_no</getProperty>
			</mapping>
		</sql>
		
		<sql id="updateSurveyCustFnsh">
            <query>
               <![CDATA[
                    UPDATE tb_survey_cust
                    SET    proc_yn = 'Y',
                    	   proc_dt = NOW()
                    WHERE user_lecture_seq_no = ?
                ]]>
            </query>
            <mapping>
                <setProperty>
                	user_lecture_seq_no
                </setProperty>
                <getProperty>
                </getProperty>
            </mapping>
        </sql>	
        
       
		<sql id="deleteSurveyAnsw">
