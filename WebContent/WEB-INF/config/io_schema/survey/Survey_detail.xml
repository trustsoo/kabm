			<![CDATA[
				INSERT INTO tb_survey_answ
				(answ_seq_no, qstn_no, user_lecture_seq_no, answ, paper_id)
				VALUES
				((select max(answ_seq_no)+1 from tb_survey_answ), ?, ?, ?, ?)
			]]>
