<?xml version='1.0' encoding='utf-8'?>
<transaction name='popup' protocolName='db1'>
    <processor-info type='dbms' datasource=''>
    	<property name="sqlLogMode" value="bind"/>
		<property name="isPrint" value="Y"/>
        <script language="java" import="">
        <![CDATA[
            String cmd = input.getText("cmd");  
          
           
            //if( "select_all".equals(cmd) ) 
            //{
            	executeSQL(cmd, connection, input, output);
            //}           
        ]]>
        </script>
        
        <transaction-type>rollback</transaction-type>
        
        <sql id="select_popup_list">
            <query>
                <![CDATA[
                select top(?)
                        seq_no,popup_div,use_yn,start_dt,end_dt,title,link,link_method,width,height,view_div,popup_type,contents,
                        CONVERT(CHAR(10), reg_ddtm, 23) reg_ddtm,reg_emp_cd,
                        popup_emp_nm,popup_div_nm,popup_type_nm,view_div_nm,
                        rnum,tot_cnt
                  FROM 
                 (
                    select
                        ROW_NUMBER() OVER( ORDER BY seq_no desc ) AS rnum, 
                        count(*) over() tot_cnt,    
                        A.*,
                        B.emp_nm popup_emp_nm,
                        C.cd_nm popup_div_nm,
                        D.cd_nm popup_type_nm,
                        E.cd_nm view_div_nm
                    from
                        tb_kabm_popup A 
                        LEFT OUTER JOIN tb_kabm_emp B ON A.reg_emp_cd = B.emp_cd 
                        LEFT OUTER JOIN TB_KABM_CODE C ON A.popup_div = C.cd 
                        LEFT OUTER JOIN TB_KABM_CODE D ON A.popup_type = D.cd 
                        LEFT OUTER JOIN TB_KABM_CODE E ON A.view_div = E.cd 
                    WHERE   A.popup_div like '%' + ? + '%' and CONVERT(CHAR(8), A.reg_ddtm, 112) >= ? and  CONVERT(CHAR(8), A.reg_ddtm, 112) <= ?
                 ) x
                WHERE rnum > (?-1) * ?
                ]]>
            </query>
            <mapping>
                <setProperty>row_per_page,in_popup_div,in_reg_ddtm_from,in_reg_ddtm_to,cur_pg,row_per_page</setProperty>
               
                <getProperty>
                        seq_no,popup_div,use_yn,start_dt,end_dt,title,link,link_method,width,height,view_div,popup_type,contents,
                        reg_ddtm,reg_emp_cd,popup_emp_nm,popup_div_nm,popup_type_nm,view_div_nm,
                        rnum,tot_cnt
                </getProperty>
            </mapping>
        </sql>

        <sql id="select_popup_item">
            <query>
                <![CDATA[
                select seq_no,popup_div,A.use_yn,start_dt,end_dt,title,link,link_method,width,height,view_div,popup_type,contents,
                        A.reg_ddtm,reg_emp_cd, B.emp_nm popup_emp_nm,
                             (select top(1) file_no from tb_kabm_attach_file where
                            attach_div_cd ='attach_div_02'  and data_no = A.seq_no
                            order by file_no desc
                            ) AS file_no  
                from   tb_kabm_popup  A 
                LEFT OUTER JOIN tb_kabm_emp B ON A.reg_emp_cd = B.emp_cd 
                where seq_no = ?
                ]]>
            </query>
            <mapping>
                <setProperty>seq_no</setProperty>
                <getProperty>
                        seq_no,popup_div,use_yn,start_dt,end_dt,title,link,link_method,width,height,view_div,popup_type,contents,
                        reg_ddtm,reg_emp_cd,popup_emp_nm,file_no
                </getProperty>
            </mapping>
        </sql>
        
    </processor-info>
    
    <input>
        <block name="arg" repeat="1">   
            
            <field name='in_popup_div'      type='string'    size=''/>
            <field name='in_reg_ddtm_from'  type='string'    size=''/>
            <field name='in_reg_ddtm_to'     type='string'    size=''/>
            
            <field name='cur_pg' type='int' size=''/>
            <field name='row_per_page' type='int'   size=''/>
             <field name='seq_no'        type='string' size=''/>
          
        </block>
    </input>
    
    <output>
        <block id="property" name="property" repeat="1">
            <field name='cur_pg'        type='String' size=''/>
            <field name='tot_cnt'       type='String' size=''/>
            <field name='row_per_page'  type='String' size=''/>
            <field name='tot_pg'         type='String' size=''/>
        </block>

       <block id='popup_list' name='popup_list' 	repeat=''>
        	    <field name='seq_no'        type='string' size=''/>
                <field name='popup_div'     type='String' size=''/>
                <field name='use_yn'        type='String' size=''/>
                <field name='start_dt'      type='String' size='' format="yyyyMMdd->yyyy-MM-dd"/>
                <field name='end_dt'        type='String' size='' format="yyyyMMdd->yyyy-MM-dd"/>
                <field name='title'         type='String' size=''/>
                <field name='link'          type='String' size=''/>
                <field name='link_method'          type='String' size=''/>
                <field name='width'         type='String' size=''/>
                <field name='height'        type='String' size=''/>
                <field name='view_div'      type='String' size=''/>
                <field name='popup_type'    type='String' size=''/>
                <field name='contents'      type='String' size=''/>
                <field name='reg_ddtm'      type='String' size=''/>
                <field name='reg_emp_cd'    type='String' size=''/>
                <field name='popup_emp_nm'  type='String' size=''/>
                <field name='popup_div_nm'  type='String' size=''/>
                <field name='popup_type_nm'  type='String' size=''/>
                <field name='view_div_nm'  type='String' size=''/>
                <field name='rnum'  type='String' size=''/>
                <field name='tot_cnt'   type='String' size=''/>

                <field name='file_no'   type='String' size=''/>                
        </block>        
        
    </output>
    
</transaction>