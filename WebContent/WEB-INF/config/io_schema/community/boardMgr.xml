			<field name='reg_emp_cd' type='string'	size='' />
			<field name='upd_emp_cd' type='string'	size='' />
			<field name='reg_emp_nm' type='string'	size='' />
			<field name='upd_emp_nm' type='string'	size='' />
			<field name='cd' type='String'	size='' />
			<field name='cd_nm' type='String'	size='' />
			<field name='etc1' type='String'	size='' />
			<field name='etc2' type='String'	size='' />
						
		</block>
		
		<block id='brd_mng_detail' name='brd_mng_detail' repeat='1'>
			<field name='brd_mng_no' type='string'	size=''/>
			<field name='brd_nm' type='string'	size='' />
			<field name='view_type' type='string'	size='' />
