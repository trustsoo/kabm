<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[

		

	//팝업관리 리즈트 조회
	public void getPopupList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		
		//SQL Injection 공격 대비
		input = translateInjectField(input);

		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "select_popup_list");		

			input.put("in_reg_ddtm_from", input.getText("in_reg_ddtm_from").replaceAll("-","") );  //날짜 포맷 제거
			input.put("in_reg_ddtm_to", input.getText("in_reg_ddtm_to").replaceAll("-","") );  //날짜 포맷 제거

			input.put("in_popup_div","%");
			
			output = interact.execute("/mng/content/popup", input);
			
			
			String[] blockNames = new String[]{"property","popup_list"};
			
			output.put(jdf.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("row_per_page"));
			output.put(jdf.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
			 
			output.put(jdf.framework.logic.transform.TransFormConstant.JSON_DATA_TYPE, "");

			String result = getJson(output, blockNames);			
			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}


	

	//팝업 아이템
	public void getPopupItem(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);
		
		//SQL Injection 공격 대비
		input = translateInjectField(input);

		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "select_popup_item");		

			output = interact.execute("/mng/content/popup", input);

			String[] blockNames = new String[]{"popup_list"};

			String result = getJson(output, blockNames);		
			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}



    //팝업 등록/수정/삭제
	public void registPopup(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		
		bind(req, input);

		//SQL Injection 공격 대비 
		//input = translateInjectField(input);
		
		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("start_dt", input.getText("start_dt").replaceAll("-","")	);
			input.put("end_dt",	  input.getText("end_dt").replaceAll("-","")	 );

			if("regist".equals(input.getText("action")))
			{
				//seq_no 여부에 따라 insert/update 결정
				if(input.getText("seq_no").length()>0)
					input.put("cmd", "update_popup");		
				else
					input.put("cmd", "insert_popup");		
			}else if ("delete".equals(input.getText("action")))
			{
				input.put("cmd", "delete_popup");	
			}

			input.put("reg_emp_cd", getUserObject(req, resp).getId() );

			output = interact.execute("/mng/content/popup_action", input);

			//TO-DO수행 후 seq_no를 가지고 첨부 처리하여야 함.		
			
			String[] blockNames = new String[]{"popup_list"};						
			
			String result = getJson(output, blockNames);			
			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	} 


	
	]]>
	</jsp:declaration>
</jsp:root>

