<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[
	    
		private final String DAYLIST = "/mng/statistics/_statistics_day.jsp";
		private final String PAGELIST = "/mng/statistics/_statistics_page.jsp";
		private final String SEARCHLIST = "/mng/statistics/_statistics_search.jsp";
	
		
	    public void daylist(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
    			throws ServletException, IOException, Exception
		{
			setLimitCalendar("fromDate", "toDate", -12, req);	
			view.setViewPage(DAYLIST);		
		}

		public void pagelist(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
    			throws ServletException, IOException, Exception
		{			
			setLimitCalendar("fromDate", "toDate", -12, req);	
			view.setViewPage(PAGELIST);		
		}
	  
	  	public void searchlist(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
    			throws ServletException, IOException, Exception
		{				
			setLimitCalendar("fromDate", "toDate", -12, req);	
			view.setViewPage(SEARCHLIST);		
		}
	]]>
	</jsp:declaration>
</jsp:root>

