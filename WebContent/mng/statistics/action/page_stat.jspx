<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8"
		pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	
	<jsp:directive.page import="net.sf.json.JSONArray" />
	<jsp:directive.page import="net.sf.json.JSONObject" />
	
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[
	
	public void getPageStat(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();		
		bind(req, input);
		try
		{
			req.setAttribute("templet-bypass", "true");
			  
			String dataType = input.getText("rtnType");
			if("".equals(dataType))
				dataType = "jqgrid";
			
			if("".equals(input.getText("rows"))) input.put("rows", SitePropertyManager.getString("ROW_PER_PAGE"));
			if("".equals(input.getText("page"))) input.put("page", "1");
			
			input.put("cmpny_no", getUserObject(req, resp).getCmpnyNo());
			input.put("row_per_page", input.getText("rows"));
			input.put("cur_pg", input.getText("page"));
			
			input.put("statistics_date", input.getText("year_code")+input.getText("month_code"));
			
			if("xls".equals(dataType))
			{
				input.put("cur_pg", "1");
				input.put("row_per_page", "99999999");
			}
			
			//페이지 생략.
			input.put("cur_pg", "1");
			input.put("row_per_page", "99999999");
			
			input.put("cmd", "getPageStat");
			output = interact.execute("/mng/statistics/page_stat", input);			
			String[] blockNames = new String[]{"property", "page_stat_list"};
			
			if("jqgrid".equals(dataType)){
				output.put(com.ubicus.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
				output.put(com.ubicus.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("row_per_page"));
				output.put(com.ubicus.framework.logic.transform.TransFormConstant.JSON_DATA_TYPE, "jqgrid");
				
				String result = getJson(output, blockNames);				
				responseJson(result, resp);
			} 
			else if("xls".equals(dataType))
			{					 
				blockNames = new String[]{"page_stat_list"};
				
				String file = getXls("페이지뷰통계", null, output,blockNames);
				java.io.File xls = new java.io.File(file);
				java.io.FileInputStream fin = new java.io.FileInputStream(xls);
				sendFile(xls.getName(), (int)xls.length(), fin, resp, req);				
			}  
			else {
				String result = getJson(output, blockNames);				
				responseJson(result, resp);
			}
			
		} catch(Exception ex)
		{			
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}       
	
	]]>
	</jsp:declaration>
</jsp:root>
	