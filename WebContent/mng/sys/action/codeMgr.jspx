<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8"
		pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	<jsp:directive.page import="org.json.JSONObject" />
	<jsp:directive.page import="org.json.JSONArray" />
	
	
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[
	         
	public void getCodeDivList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmpny_no" , getUserObject(req,resp).getCmpnyNo() );
			input.put("cmd", "getCodeDivListAll");
			
			output = interact.execute("/common/Code", input);
			String[] blockNames = new String[]{"cd_list"};							
			
			String result = getJson(output, blockNames);
				responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}

   	public void getCodeJsonList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
   			throws ServletException, IOException, Exception
   	{
   		DataSet input = new DataSet();
   		DataSet output = new DataSet();
   		bind(req, input);
   		try
   		{
   			req.setAttribute("templet-bypass", "true");
   			String cmpny_no = getUserObject(req, resp).getCmpnyNo();
   			
   			input.put("cmd", "getCodeList");
   			
   			output = interact.execute("/common/Code", input);
   			String[] blockNames = new String[]{"cd_list"};							
   			
   			String result = getJson(output, blockNames);
   			responseJson(result, resp);	
   		} catch(Exception ex)
   		{
   			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
   			Logger.err.print(Utility.getStackTrace(ex));
   		}
   	}
    	
	public void createCode(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
        DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{			
			String cmd = null;
			
			if("U".equals(input.getText("mode")))
				cmd = "updateCode";
			else
				cmd = "insertCode";
			
			if("".equals(input.getText("prnt_cd")))
				input.put("prnt_cd", "0");
			
			String emp_cd = getUserObject(req, resp).getId();
			input.put("reg_emp_cd", emp_cd);
			input.put("upd_emp_cd", emp_cd);
			input.put("cmd", cmd);
			
			output = interact.execute("/common/Code", input);
			String result = getJsonFormat("");			
			responseJson(result, resp);	
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
   			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void deleteCode(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
        DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		req.setAttribute("templet-bypass", "true");
		try
		{			
			
			input.put("cmd", "deleteCode");
			
			output = interact.execute("/common/Code", input);
			String result = getJsonFormat("");			
			responseJson(result, resp);	
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
   			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	]]>
	</jsp:declaration>
</jsp:root>
	