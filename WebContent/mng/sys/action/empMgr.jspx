<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8"
		pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.util.encrypt.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[
	
	public void getEmpList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		
		
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmd", "getEmpList");			
			
			output = interact.execute("/common/EmpMgr", input);
			String[] blockNames = new String[]{"property","emp_info"};
			
			output.put(jdf.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("row_per_page"));
			output.put(jdf.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
			 
			output.put(jdf.framework.logic.transform.TransFormConstant.JSON_DATA_TYPE, "");
			
			String result = getJson(output, blockNames);
 			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void getEmpInfo(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		
		
		try
		{
			req.setAttribute("templet-bypass", "true");
			input.put("cmd", "getEmpinfo");			
			
			output = interact.execute("/common/EmpMgr", input);
			String[] blockNames = new String[]{"emp_info"};
			String result = getJson(output, blockNames);
 			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void saveEmpinfo(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
		throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		
		
		
		try
		{
			req.setAttribute("templet-bypass", "true");
			
			String emp_cd =  input.getText("emp_cd");
			String encKey = SitePropertyManager.getString("ENCRYPTION_KEY");
			input.put("ENCRYPTION_KEY", encKey);
			
			input.put( "passwd", emp_cd );			
			input.put("cmd", "saveEmpinfo");			
			
            output = interact.execute("/common/EmpMgr", input);
            String result = getJsonFormat("");
 			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
	public void passwdReset(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
			throws ServletException, IOException, Exception
	{
		DataSet input = new DataSet();
		DataSet output = new DataSet();
		bind(req, input);
		
		try
		{
			req.setAttribute("templet-bypass", "true");
			
			//passwd
	   		String encKey = SitePropertyManager.getString( "ENCRYPTION_KEY");
	   		input.put("log_emp_no", input.getText("emp_no"));
			input.put("ENCRYPTION_KEY", encKey);
			
			String emp_id = input.getText("emp_id");
            // emp_id 가 한글인경우 영문으로 바꿔서 비밀번호 저장
            String eng_emp_id = com.kabm.util.UnicodeKorean.getKor2Eng(emp_id); 
            
            input.put("change_passwd", eng_emp_id);
			input.put("cmd", "passwdReset");
			interact.execute("/common/EmpMgr", input);
			
			String result = getJsonFormat("");
 			responseJson(result, resp);
			
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}
	
        
    //일괄삭제처리
    public void deleteEmp(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception
        {
           Logger.mon.println( getUserObject(req, resp).getId() + "  > empMgr.jspx deleteEmp called");     
        
        
            DataSet input = new DataSet();
            DataSet output = new DataSet();
            bind(req, input);
            
            try
            {
                req.setAttribute("templet-bypass", "true");
                
                input.put("cmd", "deleteEmp");          
                input.put("user_no", getUserObject(req, resp).getUser_seq_no());
                
                String emp_nos = input.getText("emp_nos");
                String[] emp_arr = SmartStringArray.split(",", emp_nos);
                
                int emp_idx = 0;
                
                for(int i = 0; i < emp_arr.length; i++)
                {
                    input.put("emp_no_id", emp_arr[i], emp_idx);
                    emp_idx++;
                }
                
                interact.execute("/common/EmpMgr", input);
    			
    			String result = getJsonFormat("");
     			responseJson(result, resp);
            } catch(Exception ex)
            {
            	responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
                Logger.err.print(Utility.getStackTrace(ex));
            }
        }
    
    //아이디 중복체크
    public void checkUserId(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception
    {
            
        
        Logger.mon.println( getUserObject(req, resp).getId() + "  > empMgr.jspx checkUserId called");           
        
        DataSet input = new DataSet();
        DataSet output = new DataSet();
        bind(req, input);
        try
        {
            req.setAttribute("templet-bypass", "true");
            
            String cmpny_no =  getUserObject(req, resp).getCmpnyNo();
            
            input.put("cmd", "checkUserId");            
            
			output = interact.execute("/common/EmpMgr", input);
			
            String[] blockNames = new String[] {"property", "check_user_id"};
            String result = getJson(output, blockNames);
            responseJson(result, resp);
            
        } catch(Exception ex)
        {
        	responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
            Logger.err.print(Utility.getStackTrace(ex));
        }
    }
    
    
		
	]]>
	</jsp:declaration>
</jsp:root>
	