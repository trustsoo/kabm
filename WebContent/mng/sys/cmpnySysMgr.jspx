    public void getLogList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception
    {
        DataSet input = new DataSet();
        DataSet output = new DataSet();
        bind(req, input);
        
        try
        {
            req.setAttribute("input", input);
            req.setAttribute("output", output);
            req.setAttribute("cmpny_no", getUserObject(req, resp).getCmpnyNo());
            
            String today =  DateTime.getFormatString("yyyyMMdd");
            
            req.setAttribute("today", today);
            req.setAttribute("prevday", DateTime.getAdjustDate(today, java.util.Calendar.MONTH, -1));
            
            view.setViewPage(LOG_LIST_PAGE);            
        } catch(Exception ex)
        {
            throw ex;
        }
    }
    
    public void getAdminLogList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception
    {
        DataSet input = new DataSet();
        DataSet output = new DataSet();
        bind(req, input);
        
        try
        {
            req.setAttribute("input", input);
            req.setAttribute("output", output);
            req.setAttribute("cmpny_no", getUserObject(req, resp).getCmpnyNo());
            
            String today =  DateTime.getFormatString("yyyyMMdd");
            
            req.setAttribute("today", today);
            req.setAttribute("prevday", today);
            
            view.setViewPage(ADMIN_LOG_LIST_PAGE);          
        } catch(Exception ex)
        {
            throw ex;
        }
    }
    
    public void getLogDetail(HttpServletRequest req, HttpServletResponse resp, ViewMeta view)
            throws ServletException, IOException, Exception
    {
        DataSet input = new DataSet();
        DataSet output = new DataSet();
        bind(req, input);
        
        try
        {
            int seq_no = Integer.parseInt(input.getText("seq_no"));
            String rowid = input.getText("rowid");
            input.put("seq_no",seq_no);
            input.put("cmd", "getLogDetail");
            log("input>>>>>>>>>>>>>>>>>>>>"+input);
            output = interact.execute("/common/Log", input);
            output.put("rowid",rowid);
            log("output>>>>>>>>>>>>>>>>>>"+output);
            
            
            req.setAttribute("input", input);
            req.setAttribute("output", output);
            req.setAttribute("cmpny_no", getUserObject(req, resp).getCmpnyNo());
            view.setViewPage(LOG_DETAIL_PAGE);          
        } catch(Exception ex)
        {
            throw ex;
        }
    }
    
    
    ]]>
    </jsp:declaration>
</jsp:root>