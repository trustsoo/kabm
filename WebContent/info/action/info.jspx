<?xml version="1.0" encoding="UTF-8" ?>

<jsp:root xmlns:jsp="http://java.sun.com/JSP/Page" version="2.0">
	<jsp:directive.page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" />
	
	<jsp:directive.page extends="jdf.framework.core.http.JspController" />
	<jsp:directive.page import="java.io.*" />
	<jsp:directive.page import="java.util.*" />
	<jsp:directive.page import="jdf.framework.core.http.*,jdf.framework.core.data.*" />
	<jsp:directive.page import="jdf.framework.core.util.*" />
	<jsp:directive.page import="jdf.framework.core.log.*" />
	<jsp:directive.page import="jdf.framework.core.*" />
	<jsp:directive.page import="com.kabm.util.*" />
	<jsp:directive.include file="/common/common.jsp"/>
	
	<jsp:declaration>
	<![CDATA[

	//회원정보 리즈트 조회
	public void getMBMemberList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) throws ServletException, IOException, Exception
	{
		DataSet input=new DataSet();
		DataSet output=new DataSet();

		
		bind(req, input);
		
		//SQL Injection 공격 대비
		input = translateInjectField(input);

		req.setAttribute("templet-bypass", "true");
		try
		{
			input.put("cmd", "select_mbmaster_list");		

			
			output = interact.execute("/info/mbmaster", input);
			
			
			String[] blockNames = new String[]{"property","mbmaster_list"};
			
			output.put(jdf.framework.logic.transform.TransFormConstant.ROW_PER_PAGE, input.getText("row_per_page"));
			output.put(jdf.framework.logic.transform.TransFormConstant.CUR_PG, input.getText("cur_pg"));
			 
			output.put(jdf.framework.logic.transform.TransFormConstant.JSON_DATA_TYPE, "");


			String result = getJson(output, blockNames);			
			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}

	public void getDuesList(HttpServletRequest req, HttpServletResponse resp, ViewMeta view) throws ServletException, IOException, Exception
	{
		DataSet input=new DataSet();
		DataSet output=new DataSet();
		
		bind(req, input);
		req.setAttribute("templet-bypass", "true");

		try
		{
			User session_user = getUserObject(req, resp);
			DataSet s_userData = session_user.getDataSet();
			
			input.put("cmd", "select_dues_list");
			
			output = interact.execute("/info/mbmaster", input);
						
			String[] blockNames = new String[]{"dues_list"};
			
			String result = getJson(output, blockNames);
			System.out.println( result);
			responseJson(result, resp);
		} catch(Exception ex)
		{
			responseJson(getJsonFormat(HTTPResultConstant.RESULT_INTERNAL_SERVER_ERROR, ex.getMessage(), ""), resp);
			Logger.err.print(Utility.getStackTrace(ex));
		}
	}


	]]>
	</jsp:declaration>
</jsp:root>

